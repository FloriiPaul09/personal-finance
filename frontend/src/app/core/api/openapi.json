  "components": {
    "schemas": {
      "AccountResponse": {
        "required": [
          "id",
          "name",
          "type",
          "currency",
          "initialBalance",
          "balance",
          "isArchived",
          "hasMovements",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "type": { "$ref": "#/components/schemas/AccountType" },
          "currency": { "type": "string" },
          "initialBalance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "balance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "isArchived": { "type": "boolean" },
          "hasMovements": { "type": "boolean" },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "uint32"
          }
        }
      },
      "AccountType": { "enum": ["cash", "checking", "creditCard", "savings", "other"] },
      "BudgetProgressResponse": {
        "required": [
          "categoryId",
          "budgetId",
          "month",
          "limit",
          "spent",
          "remaining",
          "ratio",
          "isOverBudget"
        ],
        "type": "object",
        "properties": {
          "categoryId": { "type": "string", "format": "uuid" },
          "budgetId": { "type": "string", "format": "uuid" },
          "month": { "$ref": "#/components/schemas/YearMonth" },
          "limit": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "spent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "remaining": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "ratio": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "isOverBudget": { "type": "boolean" }
        }
      },
      "BudgetResponse": {
        "required": ["id", "categoryId", "from", "amount", "version"],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "categoryId": { "type": "string", "format": "uuid" },
          "from": { "$ref": "#/components/schemas/YearMonth" },
          "amount": {
