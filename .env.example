# Copy to .env and replace every placeholder: cp .env.example .env
# .env is ignored by git. Never commit real values.
# Reference for every variable: docs/devops/configuration.md
#
# Local development works without a .env file: Compose and appsettings.Development.json
# share development-only defaults. Use .env to override them, and always for any
# instance reachable by other people.

# --- Database (compose service "db") ----------------------------------------
POSTGRES_DB=personal_finance
POSTGRES_USER=personal_finance
POSTGRES_PASSWORD=change-me
# Host port mapped to PostgreSQL, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- API (read by the api service once it is added to compose.yaml) ---------
ASPNETCORE_ENVIRONMENT=Production
# Inside Compose the database host is the service name "db".
ConnectionStrings__Default=Host=db;Port=5432;Database=personal_finance;Username=personal_finance;Password=change-me

# --- Authentication (ADR-0001) -----------------------------------------------
# Public registration. Keep false unless the instance is meant for several people.
Auth__AllowRegistration=false
# Initial user, created at the first start when the database has no users.
# Ignored afterwards: changing these values does not change an existing user.
Auth__InitialUser__Email=you@example.com
# At least 12 characters.
Auth__InitialUser__Password=change-me-to-a-long-password
