# Copy to .env and replace every placeholder: cp .env.example .env
# .env is ignored by git. Never commit real values.
# Reference for every variable: docs/devops/configuration.md
#
# Local development works without a .env file: Compose and appsettings.Development.json
# share development-only defaults. Use .env to override them, and always for any
# instance reachable by other people.

# --- Compose ------------------------------------------------------------------
# compose.app.yaml adds the api and frontend containers to the database of compose.yaml.
# Remove this line to start only the database (development).
COMPOSE_FILE=compose.yaml:compose.app.yaml
# Address and port of the app on this machine (http://localhost:8080). Keep 127.0.0.1 until HTTPS is set up:
# the session cookie is Secure, which browsers accept over plain HTTP only on localhost.
APP_BIND=127.0.0.1
APP_PORT=8080
# Published images instead of local builds (release workflow, later). Default: built from the repository.
# API_IMAGE=ghcr.io/floriipaul09/personal-finance-api:1.0.0
# FRONTEND_IMAGE=ghcr.io/floriipaul09/personal-finance-frontend:1.0.0

# --- Database (compose service "db") ----------------------------------------
POSTGRES_DB=personal_finance
POSTGRES_USER=personal_finance
# Required with compose.app.yaml. Generate one with: openssl rand -base64 32  (avoid ";" and "$")
POSTGRES_PASSWORD=change-me
# Host port mapped to PostgreSQL, bound to 127.0.0.1 only (development; not published with compose.app.yaml).
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------------
# compose.app.yaml runs the API in Production and builds its connection string from the POSTGRES_* values.
# To run the API outside Compose against another database, set it yourself:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=personal_finance;Username=personal_finance;Password=change-me

# --- Authentication (ADR-0001) -----------------------------------------------
# Public registration. Keep false unless the instance is meant for several people.
Auth__AllowRegistration=false
# Initial user, created at the first start when the database has no users. Required with compose.app.yaml.
# Ignored afterwards: changing these values does not change an existing user.
Auth__InitialUser__Email=you@example.com
# At least 12 characters.
Auth__InitialUser__Password=change-me-to-a-long-password
# Login and registration attempts per client address per window (defaults shown).
# Auth__LoginRateLimit__PermitLimit=10
# Auth__LoginRateLimit__WindowSeconds=60
