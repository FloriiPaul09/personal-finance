# Text files are stored and checked out with LF on every OS (also used inside Linux containers).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles are generated: collapsed in GitHub diffs, excluded from language stats.
pnpm-lock.yaml linguist-generated
